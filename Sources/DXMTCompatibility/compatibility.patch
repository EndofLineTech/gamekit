+#include <memory>
+#include <mutex>
+#include <unordered_map>
 
 namespace dxmt {
 
+// Wine < 10.18 has no D3DKMT shared-resource objects. Retain the useful
+// same-process subset of pre-v0.72 DXMT without exposing/dereferencing raw COM
+// pointers from handles. NT handles and keyed mutexes still require D3DKMT.
+struct LegacySharedTexture;
+struct LegacySharedTextureRegistry {
+  std::mutex mutex;
+  std::unordered_map<uintptr_t, std::weak_ptr<LegacySharedTexture>> textures;
+  uint64_t next = 1;
+};
+static LegacySharedTextureRegistry &legacy_registry() {
+  static auto *registry = new LegacySharedTextureRegistry();
+  return *registry; // Lives through DLL/process teardown; entries are weak.
+}
+struct LegacySharedTexture {
+  Rc<Texture> texture;
+  D3D11_TEXTURE2D_DESC1 desc;
+  uint64_t device_id;
+  uintptr_t handle = 0;
+  ATOM atom = 0;
+  ~LegacySharedTexture() {
+    auto &registry = legacy_registry();
+    {
+      std::lock_guard lock(registry.mutex);
+      registry.textures.erase(handle);
+    }
+    if (atom) GlobalDeleteAtom(atom);
+  }
+};
+static bool register_legacy_texture(const std::shared_ptr<LegacySharedTexture> &texture) {
+  auto &registry = legacy_registry();
+  std::lock_guard lock(registry.mutex);
+  if (registry.next == UINT64_MAX || registry.textures.size() >= 65536) return false;
+  WCHAR name[96];
+  swprintf(name, 96, L"GamekitDXMTLegacy:%lu:%llu", GetCurrentProcessId(), (unsigned long long)registry.next++);
+  // Global atoms make live tokens unique across the Wine prefix, so a token
+  // from another process cannot accidentally alias one of our own textures.
+  texture->atom = GlobalAddAtomW(name);
+  if (!texture->atom) return false;
+  texture->handle = 0x20000003 | (uintptr_t(texture->atom) << 2);
+  registry.textures.emplace(texture->handle, texture);
+  return true;
+}
