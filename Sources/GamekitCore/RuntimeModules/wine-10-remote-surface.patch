+/* Based on CrossOver's LGPL CX 23950 shared-memory child surface. */
+struct shm_window_surface
+{
+    struct window_surface header;
+    HANDLE section;
+    HWND parent;
+    BITMAPINFO info;
+};
+
+static struct shm_window_surface *get_shm_surface( struct window_surface *surface )
+{
+    return CONTAINING_RECORD( surface, struct shm_window_surface, header );
+}
+
+static void shm_surface_set_clip( struct window_surface *surface, const RECT *rects, UINT count )
+{
+    /* The surface bitmap already observes the DC's clip region. */
+}
+
+static BOOL shm_surface_flush( struct window_surface *window_surface, const RECT *rect, const RECT *dirty,
+                               const BITMAPINFO *color_info, const void *color_bits, BOOL shape_changed,
+                               const BITMAPINFO *shape_info, const void *shape_bits )
+{
+    struct shm_window_surface *surface = get_shm_surface( window_surface );
+    struct flush_shm_surface_params params = {0};
+
+    params.section = HandleToLong( surface->section );
+    params.hwnd = HandleToLong( surface->header.hwnd );
+    params.info = surface->info;
+    params.bounds = *dirty;
+    return send_message_timeout( surface->parent, WM_WINE_FLUSHSHMSURFACE, 0, (LPARAM)&params,
+                                 SMTO_BLOCK, 5000, FALSE );
+}
+
+static void close_remote_section( HANDLE process, HANDLE section )
+{
+    HANDLE local;
+    if (!process || !section) return;
+    if (!NtDuplicateObject( process, section, GetCurrentProcess(), &local, 0, FALSE, DUPLICATE_CLOSE_SOURCE ))
+        NtClose( local );
+}
+
+static void shm_surface_destroy( struct window_surface *window_surface )
+{
+    struct shm_window_surface *surface = get_shm_surface( window_surface );
+    OBJECT_ATTRIBUTES attr = {.Length = sizeof(attr)};
+    HANDLE process;
+    CLIENT_ID cid;
+    DWORD pid;
+
+    if (!surface->section) return;
+    get_window_thread( surface->parent, &pid );
+    cid.UniqueProcess = ULongToHandle( pid );
+    cid.UniqueThread = 0;
+    if (!NtOpenProcess( &process, PROCESS_DUP_HANDLE, &attr, &cid ))
+    {
+        close_remote_section( process, surface->section );
+        NtClose( process );
+    }
+}
+
+static const struct window_surface_funcs shm_surface_funcs =
+{
+    shm_surface_set_clip,
+    shm_surface_flush,
+    shm_surface_destroy
+};
+
+struct window_surface *create_shm_surface( HWND window, HWND parent, const RECT *visible_rect,
+                                           struct window_surface *old_surface )
+{
+    OBJECT_ATTRIBUTES attr = {.Length = sizeof(attr)};
+    struct shm_window_surface *surface;
+    LARGE_INTEGER section_size;
+    CLIENT_ID cid;
+    BITMAPINFO info = {0};
+    HANDLE mapping, process;
+    HBITMAP bitmap;
+    DWORD pid;
+    RECT rect = *visible_rect;
+
+    OffsetRect( &rect, -rect.left, -rect.top );
+    if (IsRectEmpty( &rect ) || rect.right > 4096 || rect.bottom > 4096) return NULL;
+    if (old_surface && old_surface->funcs == &shm_surface_funcs && EqualRect( &old_surface->rect, &rect ))
+    {
+        window_surface_add_ref( old_surface );
+        return old_surface;
+    }
+
+    info.bmiHeader.biSize = sizeof(info.bmiHeader);
+    info.bmiHeader.biWidth = rect.right;
+    info.bmiHeader.biHeight = -rect.bottom;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biSizeImage = get_dib_image_size( &info );
+    info.bmiHeader.biCompression = BI_RGB;
+    section_size.QuadPart = info.bmiHeader.biSizeImage;
+    if (NtCreateSection( &mapping, GENERIC_READ | SECTION_MAP_READ | SECTION_MAP_WRITE, NULL,
+                          &section_size, PAGE_READWRITE, SEC_COMMIT, 0 )) return NULL;
+
+    if (!(bitmap = NtGdiCreateDIBSection( 0, mapping, 0, &info, DIB_RGB_COLORS, 0, 0, 0, NULL )))
+    {
+        NtClose( mapping );
+        return NULL;
+    }
+    surface = (struct shm_window_surface *)window_surface_create( sizeof(*surface), &shm_surface_funcs,
+                                                                    window, &rect, &info, bitmap );
+    if (!surface)
+    {
+        NtGdiDeleteObjectApp( bitmap );
+        NtClose( mapping );
+        return NULL;
+    }
+    surface->info = info;
+    surface->parent = parent;
+    get_window_thread( parent, &pid );
+    cid.UniqueProcess = ULongToHandle( pid );
+    cid.UniqueThread = 0;
+    if (NtOpenProcess( &process, PROCESS_DUP_HANDLE, &attr, &cid ))
+    {
+        window_surface_release( &surface->header );
+        NtClose( mapping );
+        return NULL;
+    }
+    if (NtDuplicateObject( GetCurrentProcess(), mapping, process, &surface->section, FILE_MAP_READ, FALSE, 0 ))
+    {
+        NtClose( process );
+        window_surface_release( &surface->header );
+        NtClose( mapping );
+        return NULL;
+    }
+    NtClose( process );
+    NtClose( mapping );
+    return &surface->header;
+}
+
+void process_surface_message( struct flush_shm_surface_params *params )
+{
+    HANDLE mapping = LongToHandle( params->section );
+    HWND hwnd = LongToHandle( params->hwnd );
+    SIZE_T view_size = 0;
+    BITMAPINFOHEADER *header = &params->info.bmiHeader;
+    RECT *bounds = &params->bounds;
+    unsigned int height;
+    void *bits = NULL;
+    HDC hdc;
+
+    /* The message may originate in a different process. Bound every offset and mapping. */
+    if (header->biSize != sizeof(*header) || header->biWidth <= 0 || header->biWidth > 8192 ||
+        header->biHeight == 0 || header->biHeight < -8192 || header->biHeight > 8192 ||
+        header->biPlanes != 1 || header->biBitCount != 32 || header->biCompression != BI_RGB) return;
+    height = abs( header->biHeight );
+    if (header->biSizeImage != (unsigned int)header->biWidth * height * 4 ||
+        bounds->left < 0 || bounds->top < 0 || bounds->right <= bounds->left ||
+        bounds->bottom <= bounds->top || bounds->right > header->biWidth || bounds->bottom > height) return;
+    if (NtMapViewOfSection( mapping, GetCurrentProcess(), &bits, 0, 0, NULL,
+                            &view_size, ViewShare, 0, PAGE_READONLY ) || !bits) return;
+    if (view_size >= header->biSizeImage && (hdc = NtUserGetDCEx( hwnd, NULL, DCX_CLIPSIBLINGS )))
+    {
+        NtGdiSetDIBitsToDeviceInternal( hdc, params->dest.x + bounds->left, params->dest.y + bounds->top,
+                                        bounds->right - bounds->left, bounds->bottom - bounds->top,
+                                        bounds->left, height - bounds->bottom, 0, height, bits,
+                                        &params->info, DIB_RGB_COLORS, 0, 0, FALSE, NULL );
+        NtUserReleaseDC( hwnd, hdc );
+        flush_window_surfaces( TRUE );
+    }
+    NtUnmapViewOfSection( GetCurrentProcess(), bits );
+}
+
+/* A normal SRCCOPY to a foreign window can succeed without publishing the
+ * owner's Cocoa surface. Transfer only the completed, bounded bitmap. */
+void present_remote_window_blt( HDC hdc_dst, HDC hdc_src, INT x_dst, INT y_dst, INT width_dst,
+                                INT height_dst, INT x_src, INT y_src, INT width_src, INT height_src )
+{
+    OBJECT_ATTRIBUTES attr = {.Length = sizeof(attr)};
+    struct flush_shm_surface_params params = {0};
+    LARGE_INTEGER section_size;
+    CLIENT_ID cid;
+    HANDLE process = NULL, mapping = NULL, remote_section = NULL;
+    HDC hdc = NULL;
+    HBITMAP bitmap = NULL, previous = NULL;
+    struct dce *dce;
+    WND *win;
+    DWORD pid;
+    HWND hwnd;
+    void *bits = NULL;
+    unsigned int i, count;
+
+    if (width_dst <= 0 || height_dst <= 0 || width_dst > 4096 || height_dst > 4096 ||
+        width_src <= 0 || height_src <= 0) return;
+    user_lock();
+    dce = get_dc_dce( hdc_dst );
+    hwnd = dce ? dce->hwnd : NULL;
+    user_unlock();
+    if (!hwnd) return;
+    win = get_win_ptr( hwnd );
+    if (win != WND_OTHER_PROCESS)
+    {
+        if (win && win != WND_DESKTOP) release_win_ptr( win );
+        return;
+    }
+    get_window_thread( hwnd, &pid );
+    if (!pid || pid == GetCurrentProcessId()) return;
+    cid.UniqueProcess = ULongToHandle( pid );
+    cid.UniqueThread = 0;
+    if (NtOpenProcess( &process, PROCESS_DUP_HANDLE, &attr, &cid )) return;
+
+    params.info.bmiHeader.biSize = sizeof(params.info.bmiHeader);
+    params.info.bmiHeader.biWidth = width_dst;
+    params.info.bmiHeader.biHeight = -height_dst;
+    params.info.bmiHeader.biPlanes = 1;
+    params.info.bmiHeader.biBitCount = 32;
+    count = (unsigned int)width_dst * height_dst;
+    params.info.bmiHeader.biSizeImage = count * 4;
+    params.bounds.right = width_dst;
+    params.bounds.bottom = height_dst;
+    params.dest.x = x_dst;
+    params.dest.y = y_dst;
+    params.hwnd = HandleToLong( hwnd );
+    section_size.QuadPart = params.info.bmiHeader.biSizeImage;
+    if (NtCreateSection( &mapping, GENERIC_READ | SECTION_MAP_READ | SECTION_MAP_WRITE, NULL,
+                          &section_size, PAGE_READWRITE, SEC_COMMIT, 0 )) goto done;
+    if (!(hdc = NtGdiCreateCompatibleDC( 0 ))) goto done;
+    if (!(bitmap = NtGdiCreateDIBSection( hdc, mapping, 0, &params.info, DIB_RGB_COLORS,
+                                          0, 0, 0, &bits ))) goto done;
+    previous = NtGdiSelectBitmap( hdc, bitmap );
+    if (!NtGdiStretchBlt( hdc, 0, 0, width_dst, height_dst, hdc_src, x_src, y_src,
+                          width_src, height_src, SRCCOPY, 0 )) goto done;
+    if (bits && !(get_window_long( hwnd, GWL_EXSTYLE ) & WS_EX_LAYERED))
+        for (i = 0; i < count; i++) ((DWORD *)bits)[i] |= 0xff000000;
+    if (NtDuplicateObject( GetCurrentProcess(), mapping, process, &remote_section,
+                            FILE_MAP_READ, FALSE, 0 )) goto done;
+    params.section = HandleToLong( remote_section );
+    send_message_timeout( hwnd, WM_WINE_FLUSHSHMSURFACE, 0, (LPARAM)&params, SMTO_BLOCK, 1000, FALSE );
+
+done:
+    close_remote_section( process, remote_section );
+    if (previous) NtGdiSelectBitmap( hdc, previous );
+    if (bitmap) NtGdiDeleteObjectApp( bitmap );
+    if (hdc) NtGdiDeleteObjectApp( hdc );
+    if (mapping) NtClose( mapping );
+    NtClose( process );
+}
