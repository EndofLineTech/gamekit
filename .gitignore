# Machine-local Beads database, audit records, credentials/config and logs.
# Backed up by Dolt to refs/dolt/data, not by ordinary source commits.
.beads/
__pycache__/
*.pyc

# Generated Swift/Xcode output; project.yml and Package.swift are authoritative.
.build/
.swiftpm/
Gamekit.xcodeproj/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcresult/

# Evaluation artifacts and private runtime/user data belong outside this repo.
Artifacts/
Runtimes/
Environments/
*.dmg
*.pkg
*.exe
*.dll
!Sources/GamekitCore/ExecutionAdapters/dxgi-version-v1.dll
*.dylib
*.app/
*.framework/
*.tar.xz
*.zip
*.log
.DS_Store
